model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Orders","Product","Customer","Date","Marketing","Inventory","_Measures","DataFolder"]

ref table Orders
ref table Product
ref table Customer
ref table Date
ref table Marketing
ref table Inventory
ref table _Measures

ref cultureInfo en-US

