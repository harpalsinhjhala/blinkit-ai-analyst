# Copy to .env for a local run. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically when the main model's free daily quota runs out
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Power BI: service principal that is a Member of the workspace
TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
WORKSPACE_ID=
SEMANTIC_MODEL_ID=
REPORT_ID=
# Optional: a secure-embed URL instead of the token embed
REPORT_EMBED_URL=

# Optional. Blank = use the rules/*.yaml whose 'model:' matches the model name; 'auto' = read the model by itself
MODEL_RULES=
